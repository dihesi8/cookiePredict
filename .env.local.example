# Cookie Chain RPC (from https://docs.cookiechain.wtf/getting-started)
NEXT_PUBLIC_COOKIE_CHAIN_RPC=https://rpc.cookiescan.io

# AI Market Analyst - pick one provider and set its key.
# Both OpenRouter and NVIDIA NIM expose an OpenAI-compatible /chat/completions API.
AI_PROVIDER=openrouter
# AI_MODEL is optional. If unset, the server asks the provider's own
# /models endpoint for a current model instead of using a hardcoded one
# that could go stale. Set this only if you want a specific model.
# AI_MODEL=some-provider-specific-model-id
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Password gate for /admin (UI-level only - real protection is the on-chain
# authority check on resolve_market, this just hides the page from visitors)
ADMIN_PASSWORD=
